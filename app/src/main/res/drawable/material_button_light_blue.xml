<?xml version="1.0" encoding="utf-8"?>
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="@dimen/cpp_material_button_inset"
    android:insetTop="@dimen/cpp_material_button_inset"
    android:insetRight="@dimen/cpp_material_button_inset"
    android:insetBottom="@dimen/cpp_material_button_inset">
<selector >
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="@dimen/cpp_material_button_corner_radius" /><solid android:color="@color/accent_blue_pressed" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/cpp_material_button_corner_radius" /><solid android:color="@color/accent_blue" />
        </shape>
    </item>
</selector>
</inset>

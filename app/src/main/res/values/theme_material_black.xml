<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="CppKeyboardButton.Material.TrueBlack.Digit" parent="CppKeyboardButton">
        <item name="android:background">@drawable/material_button_true_black</item>
        <item name="android:textColor">@color/amoled_text</item>
    </style>

    <style name="CppKeyboardButton.Material.TrueBlack.Control" parent="CppKeyboardButton">
        <item name="android:background">@drawable/material_button_true_black_control</item>
        <item name="android:textColor">@color/amoled_text_secondary</item>
    </style>

    <style name="CppKeyboardButton.Material.TrueBlack.Operation" parent="CppKeyboardButton">
        <item name="android:background">@drawable/material_button_true_black_op</item>
        <item name="android:textColor">@color/amoled_text</item>
    </style>

    <!-- Legacy alias styles so existing layouts/bindings remain valid -->
    <style name="CppKeyboardButton.Material.Black.Digit" parent="CppKeyboardButton.Material.TrueBlack.Digit" />
    <style name="CppKeyboardButton.Material.Black.Digit.Highlighted" parent="CppKeyboardButton.Material.TrueBlack.Digit" />
    <style name="CppKeyboardButton.Material.Black.Control" parent="CppKeyboardButton.Material.TrueBlack.Control" />
    <style name="CppKeyboardButton.Material.Black.Operation" parent="CppKeyboardButton.Material.TrueBlack.Operation" />
    <style name="CppKeyboardButton.Material.Black.Operation.Highlighted" parent="CppKeyboardButton.Material.TrueBlack.Operation" />

    <style name="Cpp.Theme.Material.Black" parent="Cpp.Theme">
        <item name="android:windowBackground">@color/amoled_black</item>
        <item name="cpp_editor_bg">@color/amoled_editor_bg</item>
        <item name="cpp_fab_bg">@color/amoled_button_op</item>
        <item name="colorAccent">@color/amoled_accent</item>
        <item name="cpp_text_color">@color/amoled_text</item>
        <item name="cpp_button_style_digit">@style/CppKeyboardButton.Material.TrueBlack.Digit</item>
        <item name="cpp_button_style_control">@style/CppKeyboardButton.Material.TrueBlack.Control</item>
        <item name="cpp_button_style_control_highlighted">@style/CppKeyboardButton.Material.TrueBlack.Control</item>
        <item name="cpp_button_style_operation">@style/CppKeyboardButton.Material.TrueBlack.Operation</item>
        <item name="cpp_button_style_operation_highlighted">@style/CppKeyboardButton.Material.TrueBlack.Operation</item>
    </style>

    <style name="Cpp.Theme.Material.Black.Dialog" parent="Cpp.Theme.Dialog">
        <item name="android:windowBackground">@color/amoled_black</item>
        <item name="cpp_editor_bg">@color/amoled_editor_bg</item>
        <item name="cpp_fab_bg">@color/amoled_button_op</item>
        <item name="colorAccent">@color/amoled_accent</item>
        <item name="cpp_button_style_digit">@style/CppKeyboardButton.Material.TrueBlack.Digit</item>
        <item name="cpp_button_style_control">@style/CppKeyboardButton.Material.TrueBlack.Control</item>
        <item name="cpp_button_style_control_highlighted">@style/CppKeyboardButton.Material.TrueBlack.Control</item>
        <item name="cpp_button_style_operation">@style/CppKeyboardButton.Material.TrueBlack.Operation</item>
        <item name="cpp_button_style_operation_highlighted">@style/CppKeyboardButton.Material.TrueBlack.Operation</item>
    </style>

    <style name="Cpp.Theme.Material.Black.Dialog.Alert" parent="Cpp.Theme.Dialog.Alert">
        <item name="android:windowBackground">@color/amoled_black</item>
        <item name="cpp_editor_bg">@color/amoled_editor_bg</item>
        <item name="cpp_fab_bg">@color/amoled_button_op</item>
        <item name="colorAccent">@color/amoled_accent</item>
        <item name="cpp_button_style_digit">@style/CppKeyboardButton.Material.TrueBlack.Digit</item>
        <item name="cpp_button_style_control">@style/CppKeyboardButton.Material.TrueBlack.Control</item>
        <item name="cpp_button_style_control_highlighted">@style/CppKeyboardButton.Material.TrueBlack.Control</item>
        <item name="cpp_button_style_operation">@style/CppKeyboardButton.Material.TrueBlack.Operation</item>
        <item name="cpp_button_style_operation_highlighted">@style/CppKeyboardButton.Material.TrueBlack.Operation</item>
    </style>

    <style name="Cpp.Theme.Material.Black.Calculator" parent="Cpp.Theme.Material.Black">
        <item name="android:windowBackground">@color/amoled_black</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

</resources>
